# Copy to a deployment-held environment file; do not commit credentials.
DATABASE_URL=postgresql+psycopg://PILOT_DB_USER:PILOT_DB_PASSWORD@127.0.0.1:5432/triage_pilot
PILOT_REVIEW_ENABLED=true
PILOT_REVIEWER_REGISTRY={"maintainer-1":{"cohort":"MAINTAINER","token":"REPLACE","repositories":["owner/repository"]},"engineer-1":{"cohort":"INDEPENDENT_ENGINEER","token":"REPLACE","repositories":["owner/repository"]},"engineer-2":{"cohort":"INDEPENDENT_ENGINEER","token":"REPLACE","repositories":["owner/repository"]}}
WEBHOOK_ALLOWED_REPOSITORIES=owner/repository
LIVE_DEMO_REPOSITORIES=owner/repository
# Keep disabled by default. When enabled, either list allowed issue numbers or
# set LIVE_DEMO_ALLOW_ANY_ISSUE=true for an authenticated operator-only intake.
LIVE_DEMO_ENABLED=false
LIVE_DEMO_ALLOWED_ISSUE_NUMBERS=
LIVE_DEMO_ALLOW_ANY_ISSUE=false
BUDGET_OPENAI_PER_INVESTIGATION_USD=1.00
BUDGET_OPENAI_REPOSITORY_DAILY_USD=20.00
BUDGET_OPENAI_REPOSITORY_MONTHLY_USD=100.00
BUDGET_OPENAI_RESERVATION_USD=0.10
WORKER_CONCURRENCY=2
WORKER_PER_REPOSITORY_CONCURRENCY=2
GITHUB_AUTO_POST_ENABLED=false
GITHUB_AUTO_POST_DRY_RUN=true
GITHUB_AUTO_POST_REPOSITORIES=
PILOT_SESSION_SECURE_COOKIE=true
