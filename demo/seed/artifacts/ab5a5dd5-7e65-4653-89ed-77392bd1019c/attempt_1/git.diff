+def test_create_default_tool_context_forwards_proxy_configuration(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Default tool context should configure its client for a proxy."""
+    openai_mod = types.ModuleType("openai")
+    captured_kwargs: dict[str, Any] = {}
+
+    class StubAsyncOpenAI:
+        def __init__(self, **kwargs: Any) -> None:
+            captured_kwargs.update(kwargs)
+
+    openai_mod.AsyncOpenAI = StubAsyncOpenAI
+    monkeypatch.setitem(sys.modules, "openai", openai_mod)
+
+    agents._create_default_tool_context(
+        api_key="proxy-key",
+        base_url="https://litellm.example/v1",
+    )
+
+    assert captured_kwargs == {  # noqa: S101
+        "api_key": "proxy-key",
+        "base_url": "https://litellm.example/v1",
+    }
+
+
