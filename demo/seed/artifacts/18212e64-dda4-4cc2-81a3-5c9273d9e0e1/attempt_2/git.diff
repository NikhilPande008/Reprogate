+@pytest.mark.asyncio
+async def test_call_model_input_filter_accepts_custom_response_format() -> None:
+    model = FakeModel()
+    agent = Agent(name="test", model=model)
+    model.set_next_output([get_text_message("ok")])
+    response_format: ResponseFormat = {"type": "json_object"}
+
+    def filter_fn(data: CallModelData[Any]) -> ModelInputData:
+        return ModelInputData(
+            input=data.model_data.input,
+            instructions=data.model_data.instructions,
+            response_format=response_format,
+        )
+
+    await Runner.run(
+        agent,
+        input="start",
+        run_config=RunConfig(call_model_input_filter=filter_fn),
+    )
+
+    assert model.last_turn_args["response_format"] == response_format
+
